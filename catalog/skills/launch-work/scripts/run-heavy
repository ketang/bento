#!/usr/bin/env bash
# Compatibility shim: run a heavy command through the host-wide admission governor (contract v1).
#
# Usage: run-heavy [--weight N | --exclusive] [--repo REPO] [--label LABEL] [--max-wait SECONDS] [--] <cmd> [args...]
#
# Fails closed: if the installed governor is missing or denies admission, the command does not run.
# HEAVY_MAX_WAIT / HEAVY_LOAD_FACTOR are ignored; thresholds live in /etc/bento-governor/v1.toml.
# BENTO_GOVERNOR_BIN overrides the entrypoint (tests only).

set -euo pipefail

GOVERNOR="${BENTO_GOVERNOR_BIN:-/usr/local/bin/bento-governor-v1}"
usage() {
  echo "usage: run-heavy [--weight N | --exclusive] [--repo REPO] [--label LABEL] [--max-wait SECONDS] [--] <cmd> [args...]" >&2
}

opts=()
repo="" label=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --weight|--max-wait) [[ $# -ge 2 ]] || { usage; exit 64; }; opts+=("$1" "$2"); shift 2 ;;
    --exclusive) opts+=("$1"); shift ;;
    --repo) [[ $# -ge 2 ]] || { usage; exit 64; }; repo="$2"; shift 2 ;;
    --label) [[ $# -ge 2 ]] || { usage; exit 64; }; label="$2"; shift 2 ;;
    --) shift; break ;;
    -*) usage; exit 64 ;;
    *) break ;;
  esac
done

if [[ $# -eq 0 ]]; then
  usage
  exit 64
fi

if [[ -n "${HEAVY_MAX_WAIT:-}" ]]; then
  echo "run-heavy: HEAVY_MAX_WAIT is ignored; use --max-wait (the governor never proceeds after a timeout)" >&2
fi

if [[ ! -x "$GOVERNOR" ]]; then
  echo "run-heavy: governor $GOVERNOR is not installed; refusing to run without admission control" >&2
  exit 70
fi

if [[ -z "$repo" ]]; then
  top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  repo=$(basename "$top")
fi
[[ -n "$label" ]] || label=$(basename "$1")

exec "$GOVERNOR" run "${opts[@]}" --repo "$repo" --label "$label" -- "$@"
