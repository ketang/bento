#!/usr/bin/env python3
"""Assert documented CLI invocations satisfy their scripts' required arguments.

Every skill helper is a subprocess CLI whose usage is documented in prose
(``SKILL.md`` / ``references/*.md``). Nothing checked that the documented
invocation actually carried every flag the script's ``argparse`` parser marks
``required=True``. That gap shipped a real defect: expedition/SKILL.md
documented ``close-task`` without the parser-required ``--summary``, so an agent
copying the line got an ``argparse`` error.

This linter closes that gap. For each documented invocation listed in a per-skill
manifest under ``scripts/cli-parity/<skill>.json`` it:

1. confirms the documented command text still appears in the cited doc
   (normalized substring — guards manifest-vs-prose drift),
2. statically introspects the named script + subcommand's ``argparse`` parser
   and asserts every ``required=True`` option flag appears in that command
   (under-claiming: the doc omits a flag the parser demands), and
3. scans the cited doc for ``--flag (required)`` prose annotations and asserts
   the parser really marks that flag ``required=True`` (over-claiming: the doc
   calls a flag required when ``argparse`` does not). A flag that is
   ``required=True`` in *any* of the script's parsers satisfies the check, so a
   flag that is required on one subcommand and optional on another is not
   reported.

Introspection is AST-based (no import, no execution), so it works whether the
parser is built in ``build_parser()``, ``main()``, or at module level, and it
tracks per-subcommand ``add_parser(...)`` receivers. A required argument passed
a non-literal ``required=`` value is treated as *not* statically required (the
corpus uses ``required=True`` literals); tighten here if that changes.

``add_argument_group(...)`` is modeled: it is a ``--help``-only container, so it
inherits the bucket of the parser that created it. Patterns the module-scope
walker genuinely cannot model — ``add_mutually_exclusive_group()`` (which means
"exactly one of these", not per-flag requiredness) and ``add_argument`` calls
made on a function *parameter* (a helper that receives the parser) — raise
``UnsupportedParserPatternError`` rather than being silently skipped. A silent
skip would under-report required flags and let the very drift this linter exists
to catch pass green. If such a pattern is introduced, extend the walker to model
it instead of loosening the error.

Manifest coverage is itself convention-driven, so ``check_coverage`` closes the
gap one level up: it scans every ``catalog/skills/*/scripts/*.py`` for
``required=True`` arguments and flags any documented (sub)command that carries a
required flag but has no manifest entry — otherwise a future required-flag CLI
could ship with a documented invocation that silently escapes the parity check.

The public helpers (``required_flag_buckets``, ``required_option_flags``,
``parser_options``, ``overclaimed_flags``, ``check_invocation``,
``check_manifest``, ``check_coverage``, ``check_tree``) are import-safe and
take explicit roots so tests can point them at fixtures.
"""

from __future__ import annotations

import argparse
import ast
import json
import re
import sys
from pathlib import Path


ROOT_DIR = Path(__file__).resolve().parents[1]
DEFAULT_SKILLS_ROOT = ROOT_DIR / "catalog" / "skills"
DEFAULT_MANIFESTS_ROOT = ROOT_DIR / "scripts" / "cli-parity"

# Parser-container factories whose results this walker does not model.
# ``add_argument_group`` is modeled instead (it is a --help-only container whose
# arguments belong to the parser that created it); a mutually exclusive group
# expresses "exactly one of these", which the per-flag model cannot represent.
UNMODELED_GROUP_CALLS = ("add_mutually_exclusive_group",)

# Prose annotation the over-claim check reads, e.g. "`--target` (required)".
DOC_REQUIRED_RE = re.compile(r"`?(--[A-Za-z0-9][A-Za-z0-9_-]*)`?\s*\(required\)")


class UnsupportedParserPatternError(RuntimeError):
    """A script builds its parser in a way the AST walker cannot model.

    Raised instead of silently skipping, because a skip under-reports required
    flags and turns this linter green on exactly the drift it guards against.
    """


# --------------------------------------------------------------------------- #
# argparse introspection (static, AST-based)
# --------------------------------------------------------------------------- #

def _str_constant(node: ast.AST) -> str | None:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    return None


def _is_true_constant(node: ast.AST) -> bool:
    return isinstance(node, ast.Constant) and node.value is True


def _call_attr(node: ast.AST) -> str | None:
    """Return the attribute name for a ``x.method(...)`` call, else None."""
    if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
        return node.func.attr
    return None


def _receiver_name(call: ast.Call) -> str | None:
    """Return ``x`` for a ``x.method(...)`` call where ``x`` is a plain name."""
    func = call.func
    if isinstance(func, ast.Attribute) and isinstance(func.value, ast.Name):
        return func.value.id
    return None


def _option_strings(call: ast.Call) -> list[str]:
    """Positional string args that look like option flags (``-x`` / ``--long``)."""
    flags: list[str] = []
    for arg in call.args:
        value = _str_constant(arg)
        if value is not None and value.startswith("-"):
            flags.append(value)
    return flags


def _is_required(call: ast.Call) -> bool:
    for kw in call.keywords:
        if kw.arg == "required" and _is_true_constant(kw.value):
            return True
    return False


def _iter_ordered_statements(module: ast.Module):
    """Yield statements across the module in source order.

    Parsers may be built at module level or inside ``build_parser``/``main``;
    a flat, lineno-ordered walk of every statement lets us simulate the
    ``add_parser`` / ``add_argument`` sequence regardless of where it lives.
    """
    statements: list[ast.stmt] = []
    for node in ast.walk(module):
        if isinstance(node, ast.stmt):
            statements.append(node)
    statements.sort(key=lambda n: (getattr(n, "lineno", 0), getattr(n, "col_offset", 0)))
    return statements


_NESTED_SCOPES = (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda, ast.ClassDef)


def _walk_own_scope(node: ast.AST):
    """Yield nodes under ``node`` without descending into a nested scope.

    Assignments inside a nested ``def``/``lambda``/``class`` bind that scope's
    name, not this function's parameter, so they must not count as a rebind.
    """
    for child in ast.iter_child_nodes(node):
        if isinstance(child, _NESTED_SCOPES):
            continue
        yield child
        yield from _walk_own_scope(child)


def _rebind_lines(node: ast.AST, params: set[str]) -> dict[str, int]:
    """First line at which each parameter is rebound in this function's scope."""
    lines: dict[str, int] = {}
    for sub in _walk_own_scope(node):
        if not isinstance(sub, ast.Assign):
            continue
        for target in sub.targets:
            if isinstance(target, ast.Name) and target.id in params:
                lineno = getattr(sub, "lineno", 0)
                if target.id not in lines or lineno < lines[target.id]:
                    lines[target.id] = lineno
    return lines


def _function_parameter_receivers(module: ast.Module) -> list[str]:
    """Describe ``add_argument`` calls made on a function's own parameter.

    A helper such as ``def add_common(parser): parser.add_argument(...)`` builds
    part of a parser the module-scope walker cannot attribute to any bucket. The
    caller turns these into a hard error.

    A parameter counts as rebound — and so is left to the normal assignment walk
    — only when the reassignment happens **in this function's own scope** and
    **before** the ``add_argument`` call. A later rebind, or one inside a nested
    ``def``, does not retroactively make an earlier call safe.
    """
    found: list[str] = []
    for node in ast.walk(module):
        if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            continue
        spec = node.args
        params = {
            a.arg
            for a in (*spec.posonlyargs, *spec.args, *spec.kwonlyargs)
        }
        if spec.vararg:
            params.add(spec.vararg.arg)
        if spec.kwarg:
            params.add(spec.kwarg.arg)
        if not params:
            continue
        rebound_at = _rebind_lines(node, params)
        for sub in ast.walk(node):
            if not (isinstance(sub, ast.Call) and _call_attr(sub) == "add_argument"):
                continue
            receiver = _receiver_name(sub)
            if receiver not in params:
                continue
            rebind = rebound_at.get(receiver)
            if rebind is not None and rebind < getattr(sub, "lineno", 0):
                continue
            found.append(
                f"line {sub.lineno}: add_argument on function parameter "
                f"`{receiver}` in {node.name}()"
            )
    return found


def parser_options(script_path: Path) -> dict[str | None, list[tuple[list[str], bool]]]:
    """Return every option-flag set the script's parsers declare, by bucket.

    Keys are subcommand names (``None`` => the top-level ``ArgumentParser``);
    values are ``(option_strings, is_required)`` pairs in source order.

    Raises ``UnsupportedParserPatternError`` when the script uses a
    parser-construction pattern this walker cannot model.
    """
    source = script_path.read_text(encoding="utf-8")
    module = ast.parse(source, filename=str(script_path))

    unmodeled = [
        f"line {node.lineno}: unmodeled parser container `{_call_attr(node)}()`"
        for node in ast.walk(module)
        if isinstance(node, ast.Call) and _call_attr(node) in UNMODELED_GROUP_CALLS
    ]
    unmodeled.extend(_function_parameter_receivers(module))
    if unmodeled:
        raise UnsupportedParserPatternError(
            f"{script_path.name}: parser construction not modeled by the AST "
            f"walker: {'; '.join(sorted(unmodeled))}"
        )

    # var name -> kind: ("parser", None) | ("subparsers", None) | ("subcommand", name)
    var_kind: dict[str, tuple[str, str | None]] = {}
    subparsers_vars: set[str] = set()
    # option specs grouped by target subcommand (None => top-level parser)
    options: dict[str | None, list[tuple[list[str], bool]]] = {}

    for stmt in _iter_ordered_statements(module):
        # Assignments that (re)bind a var to a parser/subparsers/subcommand.
        if isinstance(stmt, ast.Assign) and len(stmt.targets) == 1 \
                and isinstance(stmt.targets[0], ast.Name) \
                and isinstance(stmt.value, ast.Call):
            target = stmt.targets[0].id
            call = stmt.value
            attr = _call_attr(call)
            func = call.func
            if (isinstance(func, ast.Name) and func.id == "ArgumentParser") or \
               (isinstance(func, ast.Attribute) and func.attr == "ArgumentParser"):
                var_kind[target] = ("parser", None)
            elif attr == "add_subparsers":
                var_kind[target] = ("subparsers", None)
                subparsers_vars.add(target)
            elif attr == "add_argument_group" and _receiver_name(call) in var_kind:
                # A --help-only container: its arguments belong to the parser
                # that created it, so the group inherits that parser's bucket.
                var_kind[target] = var_kind[_receiver_name(call)]
            elif attr == "add_parser" and _receiver_name(call) in subparsers_vars:
                name = _str_constant(call.args[0]) if call.args else None
                var_kind[target] = ("subcommand", name)
            else:
                # Reassignment to something we don't track clears the binding.
                var_kind.pop(target, None)
            continue

        # Bare ``x.add_argument(...)`` calls.
        call = stmt.value if isinstance(stmt, ast.Expr) else None
        if isinstance(call, ast.Call) and _call_attr(call) == "add_argument":
            receiver = _receiver_name(call)
            kind = var_kind.get(receiver) if receiver else None
            if kind is None:
                bucket: str | None = None
            elif kind[0] == "parser":
                bucket = None
            elif kind[0] == "subcommand":
                bucket = kind[1]
            else:
                continue
            flags = _option_strings(call)
            if flags:
                options.setdefault(bucket, []).append((flags, _is_required(call)))

    return options


def required_option_flags(script_path: Path, subcommand: str | None) -> list[list[str]]:
    """Return the option-flag sets that are ``required=True`` for ``subcommand``.

    Each element is the list of option strings for one required argument (e.g.
    ``["--summary"]`` or ``["-o", "--output"]``); parity is satisfied when any
    one of them appears in the documented command. ``subcommand=None`` targets
    arguments added to the top-level ``ArgumentParser``.
    """
    options = parser_options(script_path)
    return [flags for flags, required in options.get(subcommand, []) if required]


def required_flag_buckets(script_path: Path) -> dict[str | None, list[list[str]]]:
    """Return every ``required=True`` option-flag set, grouped by subcommand.

    The key is the argparse subcommand name, or ``None`` for arguments added to
    the top-level ``ArgumentParser``. Each value is the list of required
    arguments' option-string sets (see :func:`required_option_flags`). Buckets
    with no required option flags are omitted, so the keys are exactly the
    (sub)commands that carry at least one required flag.
    """
    options = parser_options(script_path)
    buckets: dict[str | None, list[list[str]]] = {}
    for subcommand, specs in options.items():
        required = [flags for flags, is_required in specs if is_required]
        if required:
            buckets[subcommand] = required
    return buckets


def overclaimed_flags(script_path: Path, doc_text: str) -> list[str]:
    """Return flags the doc annotates ``(required)`` that no parser requires.

    A flag is only reported when the script declares it somewhere *and* marks it
    ``required=True`` nowhere — so a flag that is required on one subcommand and
    optional on another is left alone, and flags belonging to some other script
    documented in the same file are ignored.
    """
    options = parser_options(script_path)
    known: set[str] = set()
    required: set[str] = set()
    for specs in options.values():
        for flags, is_required in specs:
            known.update(flags)
            if is_required:
                required.update(flags)

    claimed = dict.fromkeys(DOC_REQUIRED_RE.findall(doc_text))
    return [flag for flag in claimed if flag in known and flag not in required]


# --------------------------------------------------------------------------- #
# manifest checking
# --------------------------------------------------------------------------- #

def _normalize_command(text: str) -> str:
    """Collapse a possibly multi-line shell command to a single spaced string.

    Joins backslash-newline continuations and reduces every whitespace run to a
    single space so a command wrapped across lines in a fenced block matches the
    manifest's single-line form.
    """
    text = re.sub(r"\\\s*\n", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def _command_tokens(command: str) -> set[str]:
    return set(_normalize_command(command).split(" "))


def check_invocation(
    entry: dict, manifest_label: str, skills_root: Path
) -> list[str]:
    """Return human-readable problems for one manifest invocation entry."""
    problems: list[str] = []
    where = f"{manifest_label}"

    skill = entry.get("skill")
    doc_rel = entry.get("doc")
    command = entry.get("command")
    script_rel = entry.get("script")
    subcommand = entry.get("subcommand")

    missing = [k for k in ("skill", "doc", "command", "script")
               if not entry.get(k)]
    if missing:
        return [f"{where}: invocation missing required field(s): {', '.join(missing)}"]

    skill_root = skills_root / skill
    entry_id = f"{where}[{skill}:{subcommand or command[:40]}]"

    # 1. drift guard: the documented command must appear in the cited doc.
    doc_path = skill_root / doc_rel
    doc_text: str | None = None
    if not doc_path.is_file():
        problems.append(f"{entry_id}: doc not found: {doc_path}")
    else:
        doc_text = doc_path.read_text(encoding="utf-8")
        doc_norm = _normalize_command(doc_text)
        if _normalize_command(command) not in doc_norm:
            problems.append(
                f"{entry_id}: documented command not found in {doc_rel} "
                f"(manifest drifted from prose?)"
            )

    # 2. parity: every required flag must appear in the documented command.
    script_path = skill_root / script_rel
    if not script_path.is_file():
        problems.append(f"{entry_id}: script not found: {script_path}")
        return problems

    try:
        required = required_option_flags(script_path, subcommand)
    except SyntaxError as exc:
        problems.append(f"{entry_id}: could not parse {script_rel}: {exc}")
        return problems
    except UnsupportedParserPatternError as exc:
        problems.append(
            f"{entry_id}: {exc} — extend the walker in check-cli-arg-parity "
            f"to model this pattern; it cannot be checked as written"
        )
        return problems

    tokens = _command_tokens(command)
    for flag_set in required:
        if not any(flag in tokens for flag in flag_set):
            shown = " / ".join(flag_set)
            sub = f" {subcommand}" if subcommand else ""
            problems.append(
                f"{entry_id}: documented command omits required flag "
                f"`{shown}` for {script_rel}{sub}"
            )

    # 3. over-claim guard: prose must not call a flag required that the parser
    #    treats as optional.
    if doc_text is not None:
        for flag in overclaimed_flags(script_path, doc_text):
            problems.append(
                f"{entry_id}: {doc_rel} annotates `{flag}` as (required) but "
                f"{script_rel} never marks it required=True"
            )
    return problems


def check_manifest(manifest_path: Path, skills_root: Path) -> list[str]:
    """Check every invocation in a single per-skill manifest file."""
    label = manifest_path.name
    try:
        data = json.loads(manifest_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        return [f"{label}: invalid JSON: {exc}"]
    if not isinstance(data, dict) or not isinstance(data.get("invocations"), list):
        return [f"{label}: manifest must be an object with an 'invocations' list"]

    default_skill = manifest_path.stem
    problems: list[str] = []
    for entry in data["invocations"]:
        if not isinstance(entry, dict):
            problems.append(f"{label}: each invocation must be an object")
            continue
        entry = {"skill": default_skill, **entry}
        problems.extend(check_invocation(entry, label, skills_root))
    return problems


# --------------------------------------------------------------------------- #
# coverage completeness (guards the manifests themselves against gaps)
# --------------------------------------------------------------------------- #

def _covered_tuples(manifests_root: Path) -> set[tuple[str, str, str | None]]:
    """Return ``(skill, script, subcommand)`` tuples any manifest already covers.

    ``script`` is the skill-relative path as written in the manifest;
    ``subcommand`` is ``None`` for a top-level invocation. Malformed manifests
    are skipped here — :func:`check_manifest` reports their structural problems.
    """
    covered: set[tuple[str, str, str | None]] = set()
    if not manifests_root.is_dir():
        return covered
    for manifest in sorted(manifests_root.glob("*.json")):
        try:
            data = json.loads(manifest.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            continue
        if not isinstance(data, dict) or not isinstance(data.get("invocations"), list):
            continue
        default_skill = manifest.stem
        for entry in data["invocations"]:
            if not isinstance(entry, dict):
                continue
            skill = entry.get("skill") or default_skill
            script = entry.get("script")
            if not script:
                continue
            covered.add((skill, script, entry.get("subcommand")))
    return covered


def _documented_invocations(doc_text: str, basename: str) -> tuple[bool, set[str]]:
    """Detect real invocations of ``basename`` in ``doc_text``.

    Returns ``(invoked, subcommands)``: ``invoked`` is True if the script's
    filename appears *as a command* — followed on the same (backslash-joined)
    line by at least one ``-``/``--`` flag token — and ``subcommands`` is the set
    of first bare tokens preceding that flag on each such line (the documented
    subcommand names). A bare prose mention of the filename with no flag after it
    (e.g. ``the report writer (`report.py`) ...``) is deliberately *not* counted:
    the gate must under-report, never over-report, so a mention that isn't an
    invocation cannot force a spurious manifest entry.

    Requiring a flag is sound because every bucket this gate cares about has at
    least one ``required=True`` *option* flag (positional-only requireds never
    reach a bucket), so a genuine documented invocation of such a (sub)command
    always carries a flag on its command line.

    The filename is matched on identifier boundaries (``(?<![\\w-]) ... (?![\\w-])``)
    so ``run-demo.py`` does not spuriously match ``demo.py``.
    """
    joined = re.sub(r"\\\s*\n", " ", doc_text)
    pattern = re.compile(r"(?<![\w-])" + re.escape(basename) + r"(?![\w-])")
    invoked = False
    subcommands: set[str] = set()
    for match in pattern.finditer(joined):
        rest = joined[match.end():].split("\n", 1)[0]
        tokens = [t.strip("`\"'") for t in rest.split()]
        tokens = [t for t in tokens if t]
        if not any(t.startswith("-") for t in tokens):
            continue  # a textual mention, not a command invocation
        invoked = True
        for token in tokens:
            if token.startswith("-"):
                break  # reached the first flag => no subcommand on this line
            subcommands.add(token)
            break
    return invoked, subcommands


def check_coverage(
    manifests_root: Path = DEFAULT_MANIFESTS_ROOT,
    skills_root: Path = DEFAULT_SKILLS_ROOT,
) -> list[str]:
    """Flag documented required-flag CLIs that no manifest covers.

    For every ``catalog/skills/<skill>/scripts/*.py`` that marks any argument
    ``required=True``, this asserts that each documented (sub)command carrying a
    required flag has a matching ``scripts/cli-parity/<skill>.json`` entry.
    Without this, a future skill could add a required-flag script and document an
    invocation of it while silently escaping the parity check — the same doc/arg
    drift the checker exists to catch, one level up.

    Only (sub)commands that are *documented* in the skill's ``.md`` files are
    required to have coverage; an internal-only required-flag subcommand nobody
    tells agents to run carries no doc-drift risk and is left alone.
    """
    if not skills_root.is_dir():
        return []
    covered = _covered_tuples(manifests_root)
    problems: list[str] = []
    for skill_dir in sorted(p for p in skills_root.iterdir() if p.is_dir()):
        skill = skill_dir.name
        scripts_dir = skill_dir / "scripts"
        if not scripts_dir.is_dir():
            continue
        docs = sorted(skill_dir.rglob("*.md"))
        doc_text = "\n".join(d.read_text(encoding="utf-8") for d in docs)
        for script_path in sorted(scripts_dir.glob("*.py")):
            try:
                buckets = required_flag_buckets(script_path)
            except SyntaxError as exc:
                problems.append(f"{skill}: could not parse {script_path.name}: {exc}")
                continue
            except UnsupportedParserPatternError as exc:
                problems.append(
                    f"{skill}: {exc} — extend the walker in check-cli-arg-parity "
                    f"to model this pattern; coverage cannot be checked as written"
                )
                continue
            if not buckets:
                continue
            script_rel = f"scripts/{script_path.name}"
            invoked, documented_subs = _documented_invocations(
                doc_text, script_path.name
            )
            for subcommand in buckets:
                is_documented = (
                    subcommand in documented_subs
                    if subcommand is not None
                    else invoked
                )
                if not is_documented:
                    continue
                if (skill, script_rel, subcommand) in covered:
                    continue
                sub = f" {subcommand}" if subcommand else ""
                problems.append(
                    f"{skill}: documented required-flag CLI `{script_rel}{sub}` "
                    f"has no scripts/cli-parity/{skill}.json entry "
                    f"(its documented usage would escape the parity check)"
                )
    return problems


def check_tree(
    manifests_root: Path = DEFAULT_MANIFESTS_ROOT,
    skills_root: Path = DEFAULT_SKILLS_ROOT,
) -> list[str]:
    """Check every ``*.json`` manifest, then the coverage completeness gate."""
    problems: list[str] = []
    if manifests_root.is_dir():
        for manifest in sorted(manifests_root.glob("*.json")):
            problems.extend(check_manifest(manifest, skills_root))
    problems.extend(check_coverage(manifests_root, skills_root))
    return problems


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--manifests-root",
        type=Path,
        default=DEFAULT_MANIFESTS_ROOT,
        help="directory of per-skill manifests (default: scripts/cli-parity)",
    )
    parser.add_argument(
        "--skills-root",
        type=Path,
        default=DEFAULT_SKILLS_ROOT,
        help="directory containing skill sources (default: catalog/skills)",
    )
    args = parser.parse_args(argv)

    problems = check_tree(args.manifests_root, args.skills_root)
    if problems:
        print("check-cli-arg-parity: documented CLI usage is out of sync:",
              file=sys.stderr)
        for problem in problems:
            print(f"  {problem}", file=sys.stderr)
        print(
            "Add the missing flag to the documented command, drop an inaccurate "
            "(required) annotation, or fix the manifest.",
            file=sys.stderr,
        )
        return 1
    print("check-cli-arg-parity: all documented CLI invocations satisfy their "
          "required arguments.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
