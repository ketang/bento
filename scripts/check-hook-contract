#!/usr/bin/env python3
"""Lint enforcing the hooks-read-cwd-from-stdin contract.

AGENTS.md rule: "Hook scripts must read the working directory from the `cwd`
field in the stdin JSON payload, not from `$PWD` or the process CWD. Claude Code
spawns hook processes from `$HOME`; the process CWD is never the project root."

This linter walks every hook script under `catalog/hooks/*/*/scripts/` and
enforces two checks:

  A. Process-CWD primitives are flagged. Any `os.getcwd()`, `Path.cwd()`, or
     `$PWD`/`$(pwd)` usage must carry an explicit `# hook-cwd-exempt: <reason>`
     annotation on the same line or the line immediately above it. The
     annotation documents a deliberate, reviewed fallback (e.g. a last-resort
     default when the payload lacks a usable `cwd`).

  B. Payload-first requirement. Any file that uses a process-CWD primitive must
     also reference the payload `cwd` field (`"cwd"`/`'cwd'`) — proving it reads
     the working directory from the payload as the primary source and only falls
     back to the process CWD. A file that determines a directory purely from the
     process CWD, without ever consulting the payload, is exactly the historical
     bug this lint exists to prevent.

Python hooks are analyzed with the `ast` module; shell hooks are scanned with
targeted regexes (covering both `$PWD`/`$(pwd)` and process-CWD calls embedded
in inline `python3 -c` blocks).

Exit status is 0 when all hooks comply, 1 when any violation is found.
"""

from __future__ import annotations

import argparse
import ast
import re
import sys
from pathlib import Path
from typing import NamedTuple


EXEMPT_RE = re.compile(r"#\s*hook-cwd-exempt:\s*(\S.*)$")

# Payload `cwd` field reference, e.g. .get("cwd") / ["cwd"] / 'cwd'. Only used
# for the shell/embedded-python path, where code is scanned with regex rather
# than parsed; comments are stripped from each line before this is applied so
# a decoy comment mentioning "cwd" cannot satisfy the check. The Python path
# uses an AST-based check instead (_references_payload_cwd_ast) so a "cwd"
# substring in a docstring, comment, or unrelated string literal can't
# satisfy it either.
CWD_FIELD_RE = re.compile(r"""['"]cwd['"]""")

# Canonical dotted targets that count as "process CWD" or "$PWD via
# os.environ" primitives, resolved through import-alias tracking so aliased
# imports (`from os import getcwd`, `from pathlib import Path as P`,
# `import os as _os`) are still recognized.
_GETCWD_TARGETS = {"os.getcwd"}
_PATH_CWD_TARGETS = {"pathlib.Path.cwd"}
_ENVIRON_PWD_SUBSCRIPT_TARGETS = {"os.environ"}
_ENVIRON_PWD_GET_TARGETS = {"os.environ.get"}

# `os.environ` bases recognized as decoys by `_decoy_dependencies` -- shared
# by both callers so they can't drift on which environ spellings count.
_ENVIRON_CWD_TARGETS = _ENVIRON_PWD_SUBSCRIPT_TARGETS | _ENVIRON_PWD_GET_TARGETS

# Process-CWD primitives detectable in shell (and inline python) via regex.
SHELL_PRIMITIVE_RES = [
    (re.compile(r"\$\{?PWD\b"), "$PWD"),
    (re.compile(r"\$\(\s*pwd\b"), "$(pwd)"),
    (re.compile(r"(?<![\w.])`\s*pwd\b"), "`pwd`"),
    (re.compile(r"\bos\.getcwd\s*\("), "os.getcwd()"),
    (re.compile(r"\bPath\.cwd\s*\("), "Path.cwd()"),
    (re.compile(r"\bpathlib\.Path\.cwd\s*\("), "pathlib.Path.cwd()"),
]


class Finding(NamedTuple):
    path: Path
    line: int
    message: str


def _exempt_lines(lines: list[str]) -> set[int]:
    """1-indexed line numbers carrying a non-empty `# hook-cwd-exempt:` reason."""
    exempt = set()
    for idx, line in enumerate(lines, start=1):
        if EXEMPT_RE.search(line):
            exempt.add(idx)
    return exempt


def _is_exempt(line: int, lines: list[str], exempt: set[int]) -> bool:
    """A primitive is exempt if its own line, or any line in the contiguous
    block of comment lines directly above it, carries the annotation."""
    if line in exempt:
        return True
    i = line - 1
    while i >= 1 and lines[i - 1].lstrip().startswith("#"):
        if i in exempt:
            return True
        i -= 1
    return False


def _references_payload_cwd(text: str) -> bool:
    """Shell/embedded-python path: regex over comment-stripped code only."""
    stripped = "\n".join(line.split("#", 1)[0] for line in text.splitlines())
    return bool(CWD_FIELD_RE.search(stripped))


def _collect_import_aliases(tree: ast.AST) -> dict[str, str]:
    """Map each locally-bound name to the canonical dotted path it refers to,
    so `import os as o`, `from os import getcwd`, and
    `from pathlib import Path as P` all resolve the same as their unaliased
    forms."""
    aliases: dict[str, str] = {}
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                if alias.asname:
                    aliases[alias.asname] = alias.name
                else:
                    # `import os.path` (no `as`) binds the top-level name
                    # `os`, not `os.path` — the submodule is only reachable
                    # as an attribute of that same `os` object, so `os` must
                    # still resolve to `os`, not to `os.path`.
                    top = alias.name.split(".")[0]
                    aliases[top] = top
        elif isinstance(node, ast.ImportFrom):
            if node.module is None:  # relative `from . import x` — not relevant here
                continue
            for alias in node.names:
                local = alias.asname or alias.name
                aliases[local] = f"{node.module}.{alias.name}"
    return aliases


def _resolve_dotted(node: ast.AST, aliases: dict[str, str]) -> str | None:
    """Resolve a Name/Attribute chain to its canonical dotted path, following
    import aliases. Returns None for anything else (calls, subscripts, etc.)."""
    if isinstance(node, ast.Name):
        return aliases.get(node.id, node.id)
    if isinstance(node, ast.Attribute):
        base = _resolve_dotted(node.value, aliases)
        if base is None:
            return None
        return f"{base}.{node.attr}"
    return None


def _constant_str(node: ast.AST | None) -> str | None:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    return None


def _python_primitive_calls(tree: ast.AST) -> list[tuple[int, str]]:
    """Return (lineno, label) for each process-CWD primitive in an AST:
    os.getcwd(), Path.cwd(), os.environ["PWD"], os.environ.get("PWD") —
    resolved through import aliases so `from os import getcwd`,
    `from pathlib import Path as P`, and `import os as o` are all caught."""
    aliases = _collect_import_aliases(tree)
    found: list[tuple[int, str]] = []
    for node in ast.walk(tree):
        if isinstance(node, ast.Call):
            resolved = _resolve_dotted(node.func, aliases)
            if resolved in _GETCWD_TARGETS:
                found.append((node.lineno, "os.getcwd()"))
            elif resolved in _PATH_CWD_TARGETS:
                found.append((node.lineno, "Path.cwd()"))
            elif resolved in _ENVIRON_PWD_GET_TARGETS:
                if node.args and _constant_str(node.args[0]) == "PWD":
                    found.append((node.lineno, 'os.environ.get("PWD")'))
        elif isinstance(node, ast.Subscript):
            resolved = _resolve_dotted(node.value, aliases)
            if resolved in _ENVIRON_PWD_SUBSCRIPT_TARGETS:
                if _constant_str(node.slice) == "PWD":
                    found.append((node.lineno, 'os.environ["PWD"]'))
    return found


def _is_literal_container(node: ast.AST) -> bool:
    """A dict/list/set/tuple/constant literal whose contents are *also* all
    literal — never a payload object.

    Inspecting the contents matters: `{**DEFAULTS, **payload}` and
    `[*payload_items]` are `ast.Dict`/`ast.List` nodes, but they carry the stdin
    payload. Treating them as hardcoded literals would wrongly reject a hook
    that reads `merged["cwd"]`. Any `**`/`*` unpacking (a `None` key in a Dict,
    an `ast.Starred` element) makes the container non-literal, as does any
    non-literal key, value, or element.
    """
    if isinstance(node, ast.Constant):
        return True
    if isinstance(node, ast.Dict):
        # A `None` key is `**unpacking` — the mapping being unpacked can be
        # anything, including the payload.
        return all(key is not None for key in node.keys) and all(
            _is_literal_container(child)
            for child in (*node.keys, *node.values)
            if child is not None
        )
    if isinstance(node, (ast.List, ast.Set, ast.Tuple)):
        return all(_is_literal_container(elt) for elt in node.elts)
    return False


# Names of builtin container factories. `DEFAULTS = dict(cwd='/tmp')` is just
# as hardcoded as `DEFAULTS = {'cwd': '/tmp'}`, so a call to one of these with
# only literal arguments counts as a literal binding — but only when the name
# is not rebound anywhere in the file, so a shadowed `dict` is not misread.
_LITERAL_FACTORY_NAMES = frozenset({"dict", "list", "set", "tuple", "frozenset"})

# Method calls that only read a container. Calling one of these on a name
# cannot turn a hardcoded literal into something derived from stdin, so the
# name stays a decoy candidate. Any *other* method call on a name (`.update()`,
# `.setdefault()`, `.__setitem__()`, ...) may populate it from input, so the
# name is reclassified as dynamic.
_READ_ONLY_METHODS = frozenset(
    {"get", "keys", "values", "items", "copy", "index", "count"}
)


def _bindings_without_name_node(node: ast.AST) -> list[str]:
    """Names that `node` binds through something other than an `ast.Name` in
    `Store` context -- parameters, `def`/`class`/`import` names, `except ... as`
    and `match ... case ... as` captures. Each of these stores the bound
    identifier as a plain `str` attribute, so a sweep that only looks for
    `Name`-Store nodes never sees them.

    Two callers need this, for different reasons: `_bound_names` counts them as
    shadowing a builtin container factory, and `_literal_only_names` counts the
    non-parameter ones as dynamic bindings.
    """
    if isinstance(node, ast.arg):
        return [node.arg]
    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
        return [node.name]
    if isinstance(node, (ast.Import, ast.ImportFrom)):
        return [(alias.asname or alias.name).split(".")[0] for alias in node.names]
    if isinstance(node, ast.ExceptHandler):
        return [node.name] if node.name else []
    if isinstance(node, (ast.MatchAs, ast.MatchStar)):
        return [node.name] if node.name else []
    if isinstance(node, ast.MatchMapping):
        return [node.rest] if node.rest else []
    return []


def _bound_names(tree: ast.AST) -> set[str]:
    """Every name bound anywhere in the file, by any binding form. Used only to
    detect shadowing of builtin container factories."""
    names: set[str] = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Name) and isinstance(node.ctx, ast.Store):
            names.add(node.id)
        else:
            names.update(_bindings_without_name_node(node))
    return names


def _decoy_dependencies(
    node: ast.AST,
    bound: set[str],
    environ_targets: frozenset[str],
    import_aliases: dict[str, str],
) -> frozenset[str] | None:
    """Structural decoy-shape recognizer shared by `_is_decoy_base` (the
    post-pass check inside `_references_payload_cwd_ast`, run once
    `literal_only` is known) and the pre-pass alias tracing inside
    `_binding_kind` (run while `_literal_only_names` is still computing
    `literal_only`). The two paths independently re-deriving "what counts as
    decoy-shaped" is exactly how prior holes crept in one shape at a time
    (Subscript bases, arg-taking accessors, multi-arg factory calls); this
    function is the single source of truth for both, so a shape recognized
    by one is automatically recognized by the other.

    Returns `None` when `node` is not one of the recognized decoy shapes.
    Otherwise returns the set of leaf `Name` ids the shape's decoy-ness
    depends on -- empty when the shape is unconditionally a decoy (an inline
    literal container, or `os.environ`/`os.environ.get`). A node is a decoy
    exactly when every name in its dependency set is itself literal-only:
    `_is_decoy_base` checks that directly against `literal_only`, while
    `_binding_kind` instead feeds the dependency set into the
    alias-resolution fixpoint in `_literal_only_names`, since `literal_only`
    doesn't exist yet at that point.

    Recognized shapes:
    * an inline literal container (dict/list/set/tuple/constant, checked
      recursively -- see `_is_literal_container`);
    * `os.environ` / `os.environ.get`, resolved through import aliases;
    * a bare name;
    * `Subscript` indexing over another decoy shape (`DEFAULTS['env']`);
    * a read-only accessor call, any arity, over another decoy shape
      (`DEFAULTS.get('env')`, `DEFAULTS.copy()`);
    * a literal-factory call (`dict(...)`, `list(...)`, ...) whose every
      positional and keyword argument is itself a decoy shape -- the
      dependency set is the union of theirs, so `dict(DEFAULTS, extra=X)` is
      only a decoy if both `DEFAULTS` and `X` are.
    """
    if _is_literal_container(node):
        return frozenset()
    if _resolve_dotted(node, import_aliases) in environ_targets:
        return frozenset()
    if isinstance(node, ast.Name):
        return frozenset({node.id})
    if isinstance(node, ast.Subscript):
        return _decoy_dependencies(node.value, bound, environ_targets, import_aliases)
    if isinstance(node, ast.Call):
        func = node.func
        if isinstance(func, ast.Attribute) and func.attr in _READ_ONLY_METHODS:
            return _decoy_dependencies(
                func.value, bound, environ_targets, import_aliases
            )
        if (
            isinstance(func, ast.Name)
            and func.id in _LITERAL_FACTORY_NAMES
            and func.id not in bound
        ):
            deps: set[str] = set()
            for arg in (*node.args, *(kw.value for kw in node.keywords)):
                sub = _decoy_dependencies(arg, bound, environ_targets, import_aliases)
                if sub is None:
                    return None
                deps.update(sub)
            return frozenset(deps)
    return None


def _binding_kind(
    value: ast.AST,
    bound: set[str],
    environ_targets: frozenset[str],
    import_aliases: dict[str, str],
) -> tuple[str, frozenset[str] | None]:
    """Classify an assigned value as one of:

    ("literal", None)  - unconditionally a decoy shape (see
                          `_decoy_dependencies`) with no name dependencies
    ("alias", deps)     - a decoy shape whose decoy-ness depends on every
                          name in `deps` being literal-only
    ("dynamic", None)  - not a recognized decoy shape at all
    """
    deps = _decoy_dependencies(value, bound, environ_targets, import_aliases)
    if deps is None:
        return ("dynamic", None)
    if not deps:
        return ("literal", None)
    return ("alias", deps)


def _literal_only_names(tree: ast.AST) -> set[str]:
    """Names whose every observed binding in the file is a hardcoded literal
    container -- a dict/list/set/tuple/constant literal, a literal-argument
    `dict()`/`list()`/`set()`/`tuple()`/`frozenset()` call, or an alias chain
    that bottoms out in one of those. A `.get("cwd")` or `["cwd"]` read against
    one of these names is a decoy: it cannot be reading the real stdin payload,
    since the object was hardcoded in source rather than parsed from input.

    A name drops out of this set -- i.e. its `cwd` read is accepted -- as soon
    as anything could have made it carry real input:

    * it is a function or lambda parameter;
    * it is bound by any form other than a literal assignment. Tuple unpacking,
      `for` targets, `with ... as` targets, walrus assignments, augmented
      assignments, comprehension targets, `except ... as`, `match ... as` and
      `def`/`class`/`import` rebinding all count, since each can bind a value
      derived from input;
    * it is populated or mutated in place through item or attribute assignment
      (`payload[k] = v`, `obj.attr = v`, `del payload[k]`);
    * it is the receiver of a method call that is not a known read-only
      accessor (`payload = {}` then `payload.update(json.load(sys.stdin))`);
    * it is passed as an argument to a call, which could populate it in place.

    Every one of those escapes errs toward *accepting* a `cwd` read. That is
    deliberate: this lint gates every hook in the repo, so wrongly failing a
    correct hook costs far more than letting a contrived decoy through.

    Note (scope blindness): the three classifications are file-global rather
    than per-scope, so a parameter named `DEFAULTS` in one function disarms
    decoy detection for a module-level `DEFAULTS` elsewhere in the same file.
    That direction is a false negative (a decoy slips through), never a false
    positive: because any dynamic binding anywhere rescues a name, a legitimate
    payload read can never be rejected by a same-named binding in another
    scope. Tracked as a follow-up rather than fixed here.
    """
    bound = _bound_names(tree)
    import_aliases = _collect_import_aliases(tree)

    param_names: set[str] = set()
    literal_names: set[str] = set()
    dynamic_names: set[str] = set()
    alias_sources: dict[str, set[str]] = {}
    # id() of Name nodes that are the target of a literal or alias assignment,
    # so the catch-all Store sweep below does not re-classify them as dynamic.
    assign_targets: set[int] = set()

    for node in ast.walk(tree):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
            args = node.args
            for arg in (*args.posonlyargs, *args.args, *args.kwonlyargs):
                param_names.add(arg.arg)
            if args.vararg:
                param_names.add(args.vararg.arg)
            if args.kwarg:
                param_names.add(args.kwarg.arg)
            continue

        targets: list[ast.expr] = []
        value: ast.AST | None = None
        if isinstance(node, ast.Assign):
            targets = node.targets
            value = node.value
        elif isinstance(node, ast.AnnAssign) and node.value is not None:
            targets = [node.target]
            value = node.value
        else:
            continue

        for target in targets:
            if not isinstance(target, ast.Name):
                continue
            kind, deps = _binding_kind(value, bound, _ENVIRON_CWD_TARGETS, import_aliases)
            if kind == "literal":
                literal_names.add(target.id)
                assign_targets.add(id(target))
            elif kind == "alias":
                alias_sources.setdefault(target.id, set()).update(deps)
                assign_targets.add(id(target))
            else:
                dynamic_names.add(target.id)

    for node in ast.walk(tree):
        # Any other binding form -- tuple unpack, `for`, `with ... as`, walrus,
        # augmented assign, comprehension target -- can bind a value derived
        # from input, so it makes the name dynamic.
        if (
            isinstance(node, ast.Name)
            and isinstance(node.ctx, ast.Store)
            and id(node) not in assign_targets
        ):
            dynamic_names.add(node.id)
        elif isinstance(node, (ast.Subscript, ast.Attribute)) and isinstance(
            node.ctx, (ast.Store, ast.Del)
        ):
            # In-place population: `payload[k] = v`, `obj.attr = v`, `del d[k]`.
            # The mutated name sits in *Load* position inside the Store node, so
            # the sweep above never sees it. Walk down to the root name — a
            # write to `a.b["c"]` mutates `a` just as much as a write to `a`.
            root: ast.AST = node
            while isinstance(root, (ast.Subscript, ast.Attribute)):
                root = root.value
            if isinstance(root, ast.Name):
                dynamic_names.add(root.id)
        elif _bindings_without_name_node(node):
            # `except ... as name`, `match ... as name`, `def`/`class`/`import`
            # rebinding. These store the bound identifier as a plain `str`, so
            # the `Name`-Store sweep above never sees them, yet each can bind
            # something derived from input just like a `for` target can.
            # (Parameters land here too; `param_names` already covers them.)
            dynamic_names.update(_bindings_without_name_node(node))
        elif isinstance(node, ast.Call):
            func = node.func
            if (
                isinstance(func, ast.Attribute)
                and isinstance(func.value, ast.Name)
                and func.attr not in _READ_ONLY_METHODS
            ):
                # e.g. `payload.update(json.load(sys.stdin))`
                dynamic_names.add(func.value.id)
            if (
                isinstance(func, ast.Name)
                and func.id in _LITERAL_FACTORY_NAMES
                and func.id not in bound
            ):
                # A builtin container factory copies its argument; it never
                # populates it in place. `dict(DEFAULTS)` leaves `DEFAULTS`
                # just as hardcoded as it was, so the arg sweep below -- which
                # exists to catch in-place population -- must not fire here.
                continue
            for arg in (*node.args, *(kw.value for kw in node.keywords)):
                if isinstance(arg, ast.Starred):
                    arg = arg.value
                if isinstance(arg, ast.Name):
                    # The callee could populate it in place.
                    dynamic_names.add(arg.id)

    # Least fixpoint: a name is literal-only when it has at least one binding,
    # none of them dynamic, it is not a parameter, and every alias it is bound
    # from is itself literal-only. Starting empty and only ever adding grounded
    # names means an alias cycle never resolves, which errs toward acceptance.
    candidates = literal_names | set(alias_sources)
    resolved: set[str] = set()
    changed = True
    while changed:
        changed = False
        for name in candidates:
            if name in resolved or name in dynamic_names or name in param_names:
                continue
            if all(source in resolved for source in alias_sources.get(name, ())):
                resolved.add(name)
                changed = True
    return resolved


def _references_payload_cwd_ast(tree: ast.AST) -> bool:
    """Python path: does the code read a "cwd" key from some object, e.g.
    `payload["cwd"]` or `payload.get("cwd")`? AST-based so a "cwd" substring
    in a comment, docstring, or unrelated string literal can't satisfy it --
    it must actually be used as a subscript key or a `.get()` first arg.

    Reads whose base object is provably not the stdin payload do not count:

    * an inline literal container -- `{'cwd': '/tmp'}.get('cwd')`, or an
      inline literal-factory call -- `dict(cwd='/tmp').get('cwd')`;
    * `os.environ`, which is the process environment, not the payload;
    * a name that is literal-only per `_literal_only_names`;
    * a read-only accessor chain over any of the above --
      `DEFAULTS.copy().get('cwd')`, `dict(DEFAULTS).get('cwd')`.

    A read against any other kind of object (a function parameter, a name
    assigned from a call or attribute access, or a bare attribute/call
    expression) is accepted, since proving it genuinely traces back to the
    stdin payload would require full data-flow analysis; this stays a
    lightweight, one-pass check.

    This decoy filtering applies to Python hooks only. Shell hooks still go
    through `_references_payload_cwd`, a regex over comment-stripped text,
    where a bare `'cwd'` string anywhere in the file satisfies the check.
    """
    literal_only = _literal_only_names(tree)
    import_aliases = _collect_import_aliases(tree)
    bound = _bound_names(tree)

    def _is_decoy_base(node: ast.AST) -> bool:
        # Delegates the shape recognition to `_decoy_dependencies`, the same
        # function `_binding_kind` uses for temp-variable alias tracing, so
        # the two paths can't recognize different sets of decoy shapes.
        deps = _decoy_dependencies(node, bound, _ENVIRON_CWD_TARGETS, import_aliases)
        if deps is None:
            return False
        return all(name in literal_only for name in deps)

    for node in ast.walk(tree):
        if isinstance(node, ast.Subscript):
            if _constant_str(node.slice) == "cwd":
                if not _is_decoy_base(node.value):
                    return True
        elif isinstance(node, ast.Call):
            func = node.func
            if (
                isinstance(func, ast.Attribute)
                and func.attr == "get"
                and node.args
                and _constant_str(node.args[0]) == "cwd"
            ):
                if not _is_decoy_base(func.value):
                    return True
    return False


def check_python_source(text: str, path: Path) -> list[Finding]:
    findings: list[Finding] = []
    lines = text.splitlines()
    exempt = _exempt_lines(lines)
    try:
        tree = ast.parse(text)
    except SyntaxError as exc:  # pragma: no cover - defensive
        return [Finding(path, exc.lineno or 1, f"could not parse: {exc.msg}")]

    calls = _python_primitive_calls(tree)
    for lineno, label in calls:
        if not _is_exempt(lineno, lines, exempt):
            findings.append(
                Finding(
                    path,
                    lineno,
                    f"uses process CWD via {label} without a "
                    f"`# hook-cwd-exempt: <reason>` annotation",
                )
            )
    if calls and not _references_payload_cwd_ast(tree):
        findings.append(
            Finding(
                path,
                calls[0][0],
                "determines a working directory from the process CWD but never "
                'references the payload `cwd` field; read the working directory '
                "from the stdin payload's `cwd` as the primary source",
            )
        )
    return findings


def check_shell_source(text: str, path: Path) -> list[Finding]:
    findings: list[Finding] = []
    lines = text.splitlines()
    exempt = _exempt_lines(lines)
    hit_any = False
    for idx, line in enumerate(lines, start=1):
        # Ignore comment-only lines so the annotation itself is not a "hit".
        code = line.split("#", 1)[0]
        for regex, label in SHELL_PRIMITIVE_RES:
            if regex.search(code):
                hit_any = True
                if not _is_exempt(idx, lines, exempt):
                    findings.append(
                        Finding(
                            path,
                            idx,
                            f"uses process CWD via {label} without a "
                            f"`# hook-cwd-exempt: <reason>` annotation",
                        )
                    )
                break
    if hit_any and not _references_payload_cwd(text):
        findings.append(
            Finding(
                path,
                1,
                "determines a working directory from the process CWD but never "
                'references the payload `cwd` field; read the working directory '
                "from the stdin payload's `cwd` as the primary source",
            )
        )
    return findings


def check_file(path: Path) -> list[Finding]:
    text = path.read_text(encoding="utf-8")
    if path.suffix == ".py":
        return check_python_source(text, path)
    if path.suffix == ".sh":
        return check_shell_source(text, path)
    return []


def find_hook_scripts(root: Path) -> list[Path]:
    """Hook scripts under catalog/hooks/*/*/scripts/ (Python and shell)."""
    base = root / "catalog" / "hooks"
    if not base.is_dir():
        return []
    scripts: list[Path] = []
    for path in sorted(base.glob("*/*/scripts/*")):
        if path.suffix in {".py", ".sh"} and path.is_file():
            scripts.append(path)
    return scripts


def run(root: Path) -> list[Finding]:
    findings: list[Finding] = []
    for path in find_hook_scripts(root):
        findings.extend(check_file(path))
    return findings


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--root",
        type=Path,
        default=Path(__file__).resolve().parent.parent,
        help="Repository root to scan (defaults to this script's repo).",
    )
    args = parser.parse_args(argv)

    findings = run(args.root.resolve())
    if not findings:
        return 0

    for f in findings:
        try:
            rel = f.path.relative_to(args.root.resolve())
        except ValueError:
            rel = f.path
        print(f"{rel}:{f.line}: {f.message}", file=sys.stderr)
    print(
        f"\n{len(findings)} hook-contract violation(s). "
        "See scripts/check-hook-contract for the rule and the "
        "`# hook-cwd-exempt:` escape hatch.",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
